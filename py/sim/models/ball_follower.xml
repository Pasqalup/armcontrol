<mujoco model="ball_follower">
  <compiler angle="degree"/>
  <option timestep="0.01"/>
  <visual>
    <global offwidth="640" offheight="480"/>
  </visual>

  <worldbody>
    <light name="main_light" pos="0 0 4" dir="0 0 -1" diffuse="0.8 0.8 0.8"/>
    <geom name="floor" type="plane" size="2 2 0.1" rgba="0.4 0.4 0.4 1"/>

    <!-- Top-down camera that feeds the vision pipeline -->
    <camera name="tracking" pos="0 0 2.5" xyaxes="1 0 0 0 1 0" fovy="60"/>

    <!-- Simulated ball the vision pipeline will track.
         Starts above the floor so keyboard forces push it freely. -->
    <body name="ball" pos="0.5 0.2 0.5">
      <freejoint/>
      <geom name="ball_geom" type="sphere" size="0.2" rgba="0.9 0.7 0.1 1"/>
    </body>
  </worldbody>
</mujoco>